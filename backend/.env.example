# Kopier til .env for lokal utvikling. Legg ALDRI ekte hemmeligheter i repoet.
BOKBUZZ_ENVIRONMENT=dev
BOKBUZZ_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bokbuzz
BOKBUZZ_SUPABASE_JWT_SECRET=lokal-utviklingshemmelighet-minst-32-tegn
BOKBUZZ_REQUIRE_MFA=true
BOKBUZZ_STORAGE_BACKEND=local
BOKBUZZ_AI_PROVIDER=fake
